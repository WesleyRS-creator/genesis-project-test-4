<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>testMVCSharpC</RootNamespace>
        <Description>Ce projet vise à développer une plateforme SaaS enterprise de gestion de ressources et de planification de projets, conçue pour optimiser la collaboration inter-équipes au sein des grandes organisations internationales. L'application offrira un tableau de bord centralisé et intuitif, permettant aux chefs de projet de suivre en temps réel l'avancement des tâches, d'allouer les ressources humaines et matérielles de manière optimale, et de générer des rapports analytiques détaillés et exportables. Les fonctionnalités principales incluent la gestion agile des workflows complexes, l'intégration native et sécurisée avec des outils de communication tiers (tels que Slack, Microsoft Teams et Jira), ainsi qu'un module avancé de contrôle d'accès basé sur les rôles (RBAC) pour garantir la confidentialité absolue des données sensibles. L'architecture technique repose sur une approche microservices moderne, assurant une haute disponibilité, une scalabilité horizontale sans friction et une maintenance simplifiée. L'interface utilisateur sera développée avec un framework frontend réactif pour garantir une expérience fluide, responsive et accessible sur tous les appareils. Ce système permettra aux organisations de réduire leurs délais de livraison de 30 %, d'améliorer significativement la transparence opérationnelle globale, et de s'adapter facilement aux futures évolutions métier ainsi qu'aux normes de conformité réglementaire en vigueur.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0"/>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0"/>
        <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.9.0"/>
        
        
        <Content Update="wwwroot\**" CopyToOutputDirectory="Always" />
    </ItemGroup>
</Project>
