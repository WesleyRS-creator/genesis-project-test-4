@model ProjetViewModel      
@{
    ViewData["Title"] = "Create Projet";
    var previousUrl = Context.Request.Headers["Referer"].ToString();
    if (string.IsNullOrEmpty(previousUrl))
    {
        previousUrl = "/";
    }
}

<div class="header">
    <h1 class="page-title">Projet / <span class="page-type"><span class="page-action"
                data-i18n="create"></span></span></h1>
    <a href="@Url.Action("Index")" class="btn btn-primary btn-md">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        <p data-i18n="back_list"></p>
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
	<div asp-validation-summary="All" class="error-message"></div>
}


<!-- Include Select2 utils scripts -->
<script src="~/js/jquery-3.7.1.min.js"></script>
<link rel="stylesheet" href="~/css/select2.min.css">
<script src="~/js/select2.min.js"></script>

<form class="form" method="post" enctype="multipart/form-data" asp-action="Create" asp-controller="Projet">
    <div class="form-group">
        <label for="budgetEstime">budgetEstime
        </label>
        <input type="number" asp-for="Projet.BudgetEstime" placeholder="budgetEstime" >
        <span asp-validation-for="Projet.BudgetEstime" class="field-validation-error"></span>
    </div>
    <div class="form-group">
        <label for="dateDebut">dateDebut
        </label>
        <input type="date" asp-for="Projet.DateDebut" placeholder="dateDebut" >
        <span asp-validation-for="Projet.DateDebut" class="field-validation-error"></span>
    </div>
    <div class="form-group">
        <label for="nomProjet">nomProjet
        </label>
        <input type="text" asp-for="Projet.NomProjet" placeholder="nomProjet" >
        <span asp-validation-for="Projet.NomProjet" class="field-validation-error"></span>
    </div>



    <div class="form-actions">
        <div class="form-actions-left">
            <button type="reset" class="btn btn-tertiary btn-md">
                <span data-i18n="reset"></span>
            </button>
        </div>

        <div class="form-actions-right">
            <a href="@previousUrl" type="button" class="btn btn-secondary btn-sm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
                <span data-i18n="cancel"></span>
            </a>

            <button type="submit" class="btn btn-secondary btn-sm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
                    <path d="M17 21v-8H7v8M7 3v5h8" />
                </svg>
                <span data-i18n="save"></span>
            </button>
        </div>
    </div>
</form>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

