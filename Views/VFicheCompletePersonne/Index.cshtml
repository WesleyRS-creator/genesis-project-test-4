            <input class="filter-input" type="number" id="nombreProjetsMin" name="NombreProjetsMin" value="@searchCriteria?.NombreProjetsMin">
        </div>
        <div class="filter-input-group" data-filter="nombreProjetsMax">
            <label for="">nombreProjetsMax :</label>
            <input class="filter-input" type="number" id="nombreProjetsMax" name="NombreProjetsMax" value="@searchCriteria?.NombreProjetsMax">
        </div>

    </div>
</div>

<div class="modal" id="exportModal">
    <form class="modal-content" method="post" asp-action="ExportToCsv">
        <input type="hidden" name="page" value="{pageNumberValue}" />
        <input type="hidden" name="pageSize" value="@Model.Page.Size" />
        <input type="hidden" name="sortOrder" value="@Model.CurrentSort" />
        @Html.AntiForgeryToken()

        <div class="modal-header">
            <h3><span data-i18n="export"></span></h3>
            <button type="button" class="export-close-btn" id="exportCloseBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="modal-body">
            <div class="form-group" style="margin-bottom: 5px;">
                <h4 style="font-size: 1rem; margin-bottom: 8px;" data-i18n="export_format"></h4>
                <select id="exportFormat" name="exportFormat" class="form-control" style="margin-top: 5px;">
                    <option value="csv" selected>CSV</option>
                </select>
            </div>
            <div id="csvPreviewContainer" style="margin-top: 15px;">
                <h4 style="font-size: 1rem; margin-bottom: 8px;" data-i18n="data_preview"></h4>
                <div id="csvPreview">
                    <table id="csvPreviewTable">
                        <thead>
                            <tr>
                            <th> idPersonne </th>
                            <th> nom </th>
                            <th> prenom </th>
                            <th> dateNaissance </th>
                            <th> age </th>
                            <th> biographie </th>
                            <th> numeroSs </th>
                            <th> numeroPasseport </th>
                            <th> dateExpiration </th>
                            <th> statutPasseport </th>
                            <th> nombreAdresses </th>
                            <th> villePrincipale </th>
                            <th> nombreProjets </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vFicheCompletePersonne in Model.VFicheCompletePersonnes) {

                                <tr>
                                    <td> @vFicheCompletePersonne.IdPersonne </td>
                                    <td> @vFicheCompletePersonne.Nom </td>
                                    <td> @vFicheCompletePersonne.Prenom </td>
                                    <td> @vFicheCompletePersonne.DateNaissance </td>
                                    <td> @vFicheCompletePersonne.Age </td>
                                    <td> @vFicheCompletePersonne.Biographie </td>
                                    <td> @vFicheCompletePersonne.NumeroSs </td>
                                    <td> @vFicheCompletePersonne.NumeroPasseport </td>
                                    <td> @vFicheCompletePersonne.DateExpiration </td>
                                    <td> @vFicheCompletePersonne.StatutPasseport </td>
                                    <td> @vFicheCompletePersonne.NombreAdresses </td>
                                    <td> @vFicheCompletePersonne.VillePrincipale </td>
                                    <td> @vFicheCompletePersonne.NombreProjets </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                    <div id="csvPreviewNote" style="margin-top: 6px; font-size: 0.8rem; color: #666;">
                        (@Model.Page.TotalElements)
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-tertiary btn-sm" id="exportCancelBtn">
                <span data-i18n="cancel"></span>
            </button>
            <button type="submit" class="btn btn-primary btn-sm" id="exportConfirmBtn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
                </svg>
                <span data-i18n="generate"></span>
            </button>
        </div>
    </form>
</div>

