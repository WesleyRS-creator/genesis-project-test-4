        </div>
        <div class="filter-input-group" data-filter="nombreAdressesMax">
            <label for="">nombreAdressesMax :</label>
            <input class="filter-input" type="number" id="nombreAdressesMax" name="NombreAdressesMax" value="@searchCriteria?.NombreAdressesMax">
        </div>
        <div class="filter-input-group" data-filter="villePrincipale">
            <label for="">villePrincipale :</label>
            <input class="filter-input" type="text" id="villePrincipale" name="VillePrincipale" value="@searchCriteria?.VillePrincipale">
        </div>
