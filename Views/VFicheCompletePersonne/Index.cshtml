@model VFicheCompletePersonneViewModel
@{
    ViewData["Title"] = "VFicheCompletePersonnes";
    var searchCriteria = Model?.SearchVFicheCompletePersonneCriteria;
}

<div class="header">
    <h1 class="page-title">VFicheCompletePersonne / <span class="page-type"><span class="page-action"
                data-i18n="list"></span></span>
    </h1>
    
</div>

<div class="filters" id="filters-container">
    <div class="filters-header">
        <form method="post" asp-action="Search" asp-controller="VFicheCompletePersonne" id="filtersForm">
            <div class="active-filters">
                <p data-i18n="filter"></p>

                <div class="filter-controls">
                    <div class="filter-add-wrapper">
                        <button class="btn btn-tertiary btn-sm filter-add-btn" id="addFilterBtn" type="button">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                        </button>

                        <div class="filters-dropdown">
                            <div class="filters-list">
                                <div class="filter-option" data-filter="nom">nom</div>
                                <div class="filter-option" data-filter="prenom">prenom</div>
                                <div class="filter-option" data-filter="dateNaissanceMin">dateNaissanceMin</div>
                                <div class="filter-option" data-filter="dateNaissanceMax">dateNaissanceMax</div>
                                <div class="filter-option" data-filter="ageMin">ageMin</div>
                                <div class="filter-option" data-filter="ageMax">ageMax</div>
                                <div class="filter-option" data-filter="biographie">biographie</div>
                                <div class="filter-option" data-filter="numeroSsMin">numeroSsMin</div>
                                <div class="filter-option" data-filter="numeroSsMax">numeroSsMax</div>
                                <div class="filter-option" data-filter="numeroPasseport">numeroPasseport</div>
                                <div class="filter-option" data-filter="dateExpirationMin">dateExpirationMin</div>
                                <div class="filter-option" data-filter="dateExpirationMax">dateExpirationMax</div>
                                <div class="filter-option" data-filter="statutPasseport">statutPasseport</div>
                                <div class="filter-option" data-filter="nombreAdressesMin">nombreAdressesMin</div>
                                <div class="filter-option" data-filter="nombreAdressesMax">nombreAdressesMax</div>
                                <div class="filter-option" data-filter="villePrincipale">villePrincipale</div>
                                <div class="filter-option" data-filter="nombreProjetsMin">nombreProjetsMin</div>
                                <div class="filter-option" data-filter="nombreProjetsMax">nombreProjetsMax</div>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-secondary btn-sm" type="submit" id="applyFiltersBtn">
                        <span data-i18n="apply"></span>
                    </button>
                </div>
            </div>
        </form>

        <div class="header-controls">
            <!-- Order by -->
            <div class="order-by-content">
                <label data-i18n="orderby"></label>
                <label style="font-size:12px;">@Model.CurrentSortDisplay</label>
            </div>

            <!-- Dropdown Showing content -->
            <div class="showing-dropdown">
                <label for="showingSelect" data-i18n="showing"></label>
                <select id="showingSelect" class="dropdown-select btn-sm"
                    onchange="window.location.href='@Url.Action("Index")?page=0&pageSize='+this.value">
                    <option value="5" selected="@(Model.Page.Size == 5)">5</option>
                    <option value="10" selected="@(Model.Page.Size == 10)">10</option>
                    <option value="50" selected="@(Model.Page.Size == 50)">50</option>
                    <option value="100" selected="@(Model.Page.Size == 100)">100</option>
                    <option value="200" selected="@(Model.Page.Size == 200)">200</option>
                    <option value="300" selected="@(Model.Page.Size == 300)">300</option>
                    <option value="500" selected="@(Model.Page.Size == 500)">500</option>
                    <option value="1000" selected="@(Model.Page.Size == 1000)">1000</option>
                    
                </select>
            </div>

            <!-- Bouton Exporter -->
            <button class="btn btn-tertiary btn-sm" id="exportBtn" onclick="openExportModal()">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
                </svg>
                <span data-i18n="export"></span>
            </button>
        </div>
    </div>

    <div class="filter-inputs-container" style="display: none;">
        <div class="filter-input-group" data-filter="nom">
            <label for="">nom :</label>
