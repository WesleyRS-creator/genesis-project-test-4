            <input class="filter-input" type="number" id="ageMin" name="AgeMin" value="@searchCriteria?.AgeMin">
        </div>
        <div class="filter-input-group" data-filter="ageMax">
            <label for="">ageMax :</label>
            <input class="filter-input" type="number" id="ageMax" name="AgeMax" value="@searchCriteria?.AgeMax">
        </div>
        <div class="filter-input-group" data-filter="biographie">
            <label for="">biographie :</label>
            <input class="filter-input" type="text" id="biographie" name="Biographie" value="@searchCriteria?.Biographie">
        </div>
        <div class="filter-input-group" data-filter="numeroSsMin">
            <label for="">numeroSsMin :</label>
            <input class="filter-input" type="number" id="numeroSsMin" name="NumeroSsMin" value="@searchCriteria?.NumeroSsMin">
        </div>
        <div class="filter-input-group" data-filter="numeroSsMax">
            <label for="">numeroSsMax :</label>
            <input class="filter-input" type="number" id="numeroSsMax" name="NumeroSsMax" value="@searchCriteria?.NumeroSsMax">
        </div>
        <div class="filter-input-group" data-filter="numeroPasseport">
            <label for="">numeroPasseport :</label>
            <input class="filter-input" type="text" id="numeroPasseport" name="NumeroPasseport" value="@searchCriteria?.NumeroPasseport">
        </div>
        <div class="filter-input-group" data-filter="dateExpirationMin">
            <label for="">dateExpirationMin :</label>
            <input class="filter-input" type="date" id="dateExpirationMin" name="DateExpirationMin" value="@searchCriteria?.DateExpirationMin">
        </div>
        <div class="filter-input-group" data-filter="dateExpirationMax">
            <label for="">dateExpirationMax :</label>
            <input class="filter-input" type="date" id="dateExpirationMax" name="DateExpirationMax" value="@searchCriteria?.DateExpirationMax">
        </div>
        <div class="filter-input-group" data-filter="statutPasseport">
            <label for="">statutPasseport :</label>
            <input class="filter-input" type="text" id="statutPasseport" name="StatutPasseport" value="@searchCriteria?.StatutPasseport">
