@model VFicheCompletePersonneViewModel
@{
    ViewData["Title"] = "VFicheCompletePersonne Details";
    var previousUrl = Context.Request.Headers["Referer"].ToString();
    if (string.IsNullOrEmpty(previousUrl))
    {
        previousUrl = "/";
    }
}

@using testMVCSharpC.Utils
<div class="header">
    <h1 class="page-title">VFicheCompletePersonne / <span class="page-type"><span class="page-action"
                data-i18n="details"></span></span></h1>
    <a href="@previousUrl" class="btn btn-primary btn-md">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        <p data-i18n="back_list"></p>
    </a>
</div>

<form class="form">
    <div class="form-group">
        <label for="idPersonne">idPersonne</label>
        <div class="info">

            
            <p>@Model.VFicheCompletePersonne.IdPersonne</p>
            

        </div>
    </div>
    <div class="form-group">
        <label for="nom">nom</label>
        <div class="info">

            
            <p>@Model.VFicheCompletePersonne.Nom</p>
            

        </div>
    </div>
    <div class="form-group">
        <label for="prenom">prenom</label>
        <div class="info">

            
            <p>@Model.VFicheCompletePersonne.Prenom</p>
            

        </div>
    </div>
    <div class="form-group">
