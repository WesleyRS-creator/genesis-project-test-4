@model VProjetsEtEquipeViewModel
@{
    ViewData["Title"] = "VProjetsEtEquipes";
    var searchCriteria = Model?.SearchVProjetsEtEquipeCriteria;
}

<div class="header">
    <h1 class="page-title">VProjetsEtEquipe / <span class="page-type"><span class="page-action"
                data-i18n="list"></span></span>
    </h1>
    
</div>

<div class="filters" id="filters-container">
    <div class="filters-header">
        <form method="post" asp-action="Search" asp-controller="VProjetsEtEquipe" id="filtersForm">
            <div class="active-filters">
                <p data-i18n="filter"></p>

                <div class="filter-controls">
                    <div class="filter-add-wrapper">
                        <button class="btn btn-tertiary btn-sm filter-add-btn" id="addFilterBtn" type="button">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                        </button>

                        <div class="filters-dropdown">
                            <div class="filters-list">
                                <div class="filter-option" data-filter="nomProjet">nomProjet</div>
                                <div class="filter-option" data-filter="dateDebutMin">dateDebutMin</div>
                                <div class="filter-option" data-filter="dateDebutMax">dateDebutMax</div>
                                <div class="filter-option" data-filter="budgetEstimeMin">budgetEstimeMin</div>
                                <div class="filter-option" data-filter="budgetEstimeMax">budgetEstimeMax</div>
                                <div class="filter-option" data-filter="dureeJoursMin">dureeJoursMin</div>
                                <div class="filter-option" data-filter="dureeJoursMax">dureeJoursMax</div>
                                <div class="filter-option" data-filter="nombreParticipantsMin">nombreParticipantsMin</div>
                                <div class="filter-option" data-filter="nombreParticipantsMax">nombreParticipantsMax</div>
                                <div class="filter-option" data-filter="budgetParParticipantMin">budgetParParticipantMin</div>
                                <div class="filter-option" data-filter="budgetParParticipantMax">budgetParParticipantMax</div>
                                <div class="filter-option" data-filter="listeEquipe">listeEquipe</div>
                                <div class="filter-option" data-filter="rolesDistribues">rolesDistribues</div>
                                <div class="filter-option" data-filter="derniereInscriptionMin">derniereInscriptionMin</div>
                                <div class="filter-option" data-filter="derniereInscriptionMax">derniereInscriptionMax</div>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-secondary btn-sm" type="submit" id="applyFiltersBtn">
                        <span data-i18n="apply"></span>
                    </button>
                </div>
            </div>
        </form>

        <div class="header-controls">
            <!-- Order by -->
            <div class="order-by-content">
                <label data-i18n="orderby"></label>
                <label style="font-size:12px;">@Model.CurrentSortDisplay</label>
            </div>

            <!-- Dropdown Showing content -->
            <div class="showing-dropdown">
                <label for="showingSelect" data-i18n="showing"></label>
                <select id="showingSelect" class="dropdown-select btn-sm"
                    onchange="window.location.href='@Url.Action("Index")?page=0&pageSize='+this.value">
                    <option value="5" selected="@(Model.Page.Size == 5)">5</option>
                    <option value="10" selected="@(Model.Page.Size == 10)">10</option>
                    <option value="50" selected="@(Model.Page.Size == 50)">50</option>
                    <option value="100" selected="@(Model.Page.Size == 100)">100</option>
                    <option value="200" selected="@(Model.Page.Size == 200)">200</option>
                    <option value="300" selected="@(Model.Page.Size == 300)">300</option>
                    <option value="500" selected="@(Model.Page.Size == 500)">500</option>
                    <option value="1000" selected="@(Model.Page.Size == 1000)">1000</option>
                    
                </select>
            </div>

            <!-- Bouton Exporter -->
            <button class="btn btn-tertiary btn-sm" id="exportBtn" onclick="openExportModal()">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
                </svg>
                <span data-i18n="export"></span>
            </button>
        </div>
    </div>

    <div class="filter-inputs-container" style="display: none;">
        <div class="filter-input-group" data-filter="nomProjet">
            <label for="">nomProjet :</label>
            <input class="filter-input" type="text" id="nomProjet" name="NomProjet" value="@searchCriteria?.NomProjet">
        </div>
        <div class="filter-input-group" data-filter="dateDebutMin">
            <label for="">dateDebutMin :</label>
            <input class="filter-input" type="date" id="dateDebutMin" name="DateDebutMin" value="@searchCriteria?.DateDebutMin">
        </div>
        <div class="filter-input-group" data-filter="dateDebutMax">
            <label for="">dateDebutMax :</label>
            <input class="filter-input" type="date" id="dateDebutMax" name="DateDebutMax" value="@searchCriteria?.DateDebutMax">
        </div>
        <div class="filter-input-group" data-filter="budgetEstimeMin">
            <label for="">budgetEstimeMin :</label>
            <input class="filter-input" type="number" id="budgetEstimeMin" name="BudgetEstimeMin" value="@searchCriteria?.BudgetEstimeMin">
        </div>
        <div class="filter-input-group" data-filter="budgetEstimeMax">
            <label for="">budgetEstimeMax :</label>
            <input class="filter-input" type="number" id="budgetEstimeMax" name="BudgetEstimeMax" value="@searchCriteria?.BudgetEstimeMax">
        </div>
        <div class="filter-input-group" data-filter="dureeJoursMin">
            <label for="">dureeJoursMin :</label>
            <input class="filter-input" type="number" id="dureeJoursMin" name="DureeJoursMin" value="@searchCriteria?.DureeJoursMin">
        </div>
        <div class="filter-input-group" data-filter="dureeJoursMax">
            <label for="">dureeJoursMax :</label>
            <input class="filter-input" type="number" id="dureeJoursMax" name="DureeJoursMax" value="@searchCriteria?.DureeJoursMax">
        </div>
        <div class="filter-input-group" data-filter="nombreParticipantsMin">
            <label for="">nombreParticipantsMin :</label>
            <input class="filter-input" type="number" id="nombreParticipantsMin" name="NombreParticipantsMin" value="@searchCriteria?.NombreParticipantsMin">
        </div>
        <div class="filter-input-group" data-filter="nombreParticipantsMax">
            <label for="">nombreParticipantsMax :</label>
            <input class="filter-input" type="number" id="nombreParticipantsMax" name="NombreParticipantsMax" value="@searchCriteria?.NombreParticipantsMax">
        </div>
        <div class="filter-input-group" data-filter="budgetParParticipantMin">
            <label for="">budgetParParticipantMin :</label>
            <input class="filter-input" type="number" id="budgetParParticipantMin" name="BudgetParParticipantMin" value="@searchCriteria?.BudgetParParticipantMin">
        </div>
        <div class="filter-input-group" data-filter="budgetParParticipantMax">
            <label for="">budgetParParticipantMax :</label>
            <input class="filter-input" type="number" id="budgetParParticipantMax" name="BudgetParParticipantMax" value="@searchCriteria?.BudgetParParticipantMax">
        </div>
        <div class="filter-input-group" data-filter="listeEquipe">
            <label for="">listeEquipe :</label>
            <input class="filter-input" type="text" id="listeEquipe" name="ListeEquipe" value="@searchCriteria?.ListeEquipe">
        </div>
        <div class="filter-input-group" data-filter="rolesDistribues">
            <label for="">rolesDistribues :</label>
            <input class="filter-input" type="text" id="rolesDistribues" name="RolesDistribues" value="@searchCriteria?.RolesDistribues">
        </div>
        <div class="filter-input-group" data-filter="derniereInscriptionMin">
            <label for="">derniereInscriptionMin :</label>
            <input class="filter-input" type="datetime-local" id="derniereInscriptionMin" name="DerniereInscriptionMin" value="@searchCriteria?.DerniereInscriptionMin?.ToString("yyyy-MM-ddTHH:mm")">
        </div>
        <div class="filter-input-group" data-filter="derniereInscriptionMax">
            <label for="">derniereInscriptionMax :</label>
            <input class="filter-input" type="datetime-local" id="derniereInscriptionMax" name="DerniereInscriptionMax" value="@searchCriteria?.DerniereInscriptionMax?.ToString("yyyy-MM-ddTHH:mm")">
        </div>

    </div>
</div>

<div class="modal" id="exportModal">
    <form class="modal-content" method="post" asp-action="ExportToCsv">
        <input type="hidden" name="page" value="{pageNumberValue}" />
        <input type="hidden" name="pageSize" value="@Model.Page.Size" />
        <input type="hidden" name="sortOrder" value="@Model.CurrentSort" />
        @Html.AntiForgeryToken()

        <div class="modal-header">
            <h3><span data-i18n="export"></span></h3>
            <button type="button" class="export-close-btn" id="exportCloseBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="modal-body">
            <div class="form-group" style="margin-bottom: 5px;">
                <h4 style="font-size: 1rem; margin-bottom: 8px;" data-i18n="export_format"></h4>
                <select id="exportFormat" name="exportFormat" class="form-control" style="margin-top: 5px;">
                    <option value="csv" selected>CSV</option>
                </select>
            </div>
            <div id="csvPreviewContainer" style="margin-top: 15px;">
                <h4 style="font-size: 1rem; margin-bottom: 8px;" data-i18n="data_preview"></h4>
                <div id="csvPreview">
                    <table id="csvPreviewTable">
                        <thead>
                            <tr>
                            <th> idProjet </th>
                            <th> nomProjet </th>
                            <th> dateDebut </th>
                            <th> budgetEstime </th>
                            <th> dureeJours </th>
                            <th> nombreParticipants </th>
                            <th> budgetParParticipant </th>
                            <th> listeEquipe </th>
                            <th> rolesDistribues </th>
                            <th> derniereInscription </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vProjetsEtEquipe in Model.VProjetsEtEquipes) {

                                <tr>
                                    <td> @vProjetsEtEquipe.IdProjet </td>
                                    <td> @vProjetsEtEquipe.NomProjet </td>
                                    <td> @vProjetsEtEquipe.DateDebut </td>
                                    <td> @vProjetsEtEquipe.BudgetEstime </td>
                                    <td> @vProjetsEtEquipe.DureeJours </td>
                                    <td> @vProjetsEtEquipe.NombreParticipants </td>
                                    <td> @vProjetsEtEquipe.BudgetParParticipant </td>
                                    <td> @vProjetsEtEquipe.ListeEquipe </td>
                                    <td> @vProjetsEtEquipe.RolesDistribues </td>
                                    <td> @vProjetsEtEquipe.DerniereInscription </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                    <div id="csvPreviewNote" style="margin-top: 6px; font-size: 0.8rem; color: #666;">
                        (@Model.Page.TotalElements)
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-tertiary btn-sm" id="exportCancelBtn">
                <span data-i18n="cancel"></span>
            </button>
            <button type="submit" class="btn btn-primary btn-sm" id="exportConfirmBtn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
                </svg>
                <span data-i18n="generate"></span>
            </button>
        </div>
    </form>
</div>

