@model VProjetsEtEquipeViewModel
@{
    ViewData["Title"] = "VProjetsEtEquipe Details";
    var previousUrl = Context.Request.Headers["Referer"].ToString();
    if (string.IsNullOrEmpty(previousUrl))
    {
        previousUrl = "/";
    }
}

@using testMVCSharpC.Utils
<div class="header">
    <h1 class="page-title">VProjetsEtEquipe / <span class="page-type"><span class="page-action"
                data-i18n="details"></span></span></h1>
    <a href="@previousUrl" class="btn btn-primary btn-md">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        <p data-i18n="back_list"></p>
    </a>
</div>

<form class="form">
    <div class="form-group">
        <label for="idProjet">idProjet</label>
        <div class="info">

            
            <p>@Model.VProjetsEtEquipe.IdProjet</p>
            

        </div>
    </div>
    <div class="form-group">
        <label for="nomProjet">nomProjet</label>
        <div class="info">

            
            <p>@Model.VProjetsEtEquipe.NomProjet</p>
            

        </div>
    </div>
    <div class="form-group">
        <label for="dateDebut">dateDebut</label>
        <div class="info">

            
            <p>@Model.VProjetsEtEquipe.DateDebut</p>
            

        </div>
    </div>
    <div class="form-group">
        <label for="budgetEstime">budgetEstime</label>
        <div class="info">

            
            <p>@Model.VProjetsEtEquipe.BudgetEstime</p>
            

        </div>
    </div>
    <div class="form-group">
        <label for="dureeJours">dureeJours</label>
        <div class="info">

            
            <p>@Model.VProjetsEtEquipe.DureeJours</p>
            

        </div>
    </div>
    <div class="form-group">
        <label for="nombreParticipants">nombreParticipants</label>
        <div class="info">

            
            <p>@Model.VProjetsEtEquipe.NombreParticipants</p>
            

        </div>
    </div>
    <div class="form-group">
        <label for="budgetParParticipant">budgetParParticipant</label>
        <div class="info">

            
            <p>@Model.VProjetsEtEquipe.BudgetParParticipant</p>
            

        </div>
    </div>
    <div class="form-group">
        <label for="listeEquipe">listeEquipe</label>
        <div class="info">

            
            <p>@Model.VProjetsEtEquipe.ListeEquipe</p>
            

        </div>
    </div>
    <div class="form-group">
        <label for="rolesDistribues">rolesDistribues</label>
        <div class="info">

            
            <p>@Model.VProjetsEtEquipe.RolesDistribues</p>
            

        </div>
    </div>
    <div class="form-group">
        <label for="derniereInscription">derniereInscription</label>
        <div class="info">

            
            <p>@Model.VProjetsEtEquipe.DerniereInscription</p>
            

        </div>
    </div>

    
</form>

